# === filename: .env.example ===
DATABASE_URL=sqlite+aiosqlite:///./data/siem.db
GHCR_OWNER=iamhelios04
IMAGE_TAG=latest
BUILD_FROM_SOURCE=false
AUTO_MIGRATE=true
SYSLOG_UDP_HOST=0.0.0.0
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_HOST=0.0.0.0
SYSLOG_TCP_PORT=6601
SYSLOG_TIMEZONE=Asia/Kolkata
ENABLE_SYSLOG_LISTENER=true
WEB_PORT=8080
WEB_BIND_IP=127.0.0.1
CORS_ORIGINS=http://localhost,http://localhost:5173
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-long-random-value
MAX_RECORDS_PER_QUERY=10000
MAX_INGEST_LINES=10000
SUSPICIOUS_IPS=
MAX_LOG_RETENTION_DAYS=90
ARCHIVE_DIR=./data/archive
RETENTION_CHECK_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
